# Bitkub API credentials
BITKUB_API_KEY=your_api_key_here
BITKUB_API_SECRET=your_api_secret_here

# Trading mode
DRY_RUN=True
STRATEGY=sma_crossover
LOOP_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
ORDER_TIMEOUT_SECONDS=30

# Market scanning
# Leave SCAN_SYMBOLS empty to scan top THB pairs by volume.
# Example: SCAN_SYMBOLS=btc_thb,eth_thb,sol_thb,xrp_thb
SCAN_SYMBOLS=
MAX_SCAN_SYMBOLS=30

# Order sizing
TRADE_AMOUNT_THB=300.0
MIN_TRADE_VALUE_THB=50.0
MAX_OPEN_POSITIONS=3
ALLOW_ADD_TO_POSITION=False
MAX_POSITION_VALUE_RATE=0.25
MAX_PORTFOLIO_RISK_RATE=0.02

# Fee and opportunity filters
# Bitkub fee can change; keep this configurable and update it from your account/fee tier.
TRADING_FEE_RATE=0.0025
MIN_EXPECTED_PROFIT_RATE=0.003
PROFIT_LOOKBACK_CANDLES=8
MAX_SPREAD_RATE=0.006
MIN_24H_VOLUME_THB=1000000

# Exit risk controls
STOP_LOSS_RATE=0.015
PARTIAL_TAKE_PROFIT_RATE=0.012
TAKE_PROFIT_RATE=0.015
TRAILING_STOP_RATE=0.0025
TRAILING_MIN_PROFIT_RATE=0.008
MIN_NET_PROFIT_RATE=0.004
PROFIT_LOCK_THRESHOLD=0.001
PROFIT_LOCK_TRAILING_RATE=0.0025
POSITION_ENTRY_PRICES=
TRADE_COOLDOWN_SECONDS=120
MIN_BUY_SCORE=50.0
MIN_HOLD_MINUTES=15
REQUIRE_PRICE_ABOVE_EMA50_1H=False

# Order execution type settings (market, limit, limit_ioc)
ORDER_TYPE_BUY=market
ORDER_TYPE_SELL=market
POST_ONLY=False

# Telegram notifications
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI confirmation
# Add 2 keys separated by comma. If one key hits quota, the bot rotates to the next key.
# If all keys are cooling down, the bot falls back to technical analysis automatically.
GEMINI_ENABLED=False
GEMINI_API_KEYS=
GEMINI_KEY_COOLDOWN_SECONDS=600
GEMINI_REQUEST_TIMEOUT_SECONDS=15

# AI Last Chance Scanner settings
LAST_CHANCE_MIN_CONFIDENCE=75.0
LAST_CHANCE_MAX_RISK=5.0
LAST_CHANCE_MIN_VOLUME_THB=1000000.0
LAST_CHANCE_MAX_SPREAD=0.006
