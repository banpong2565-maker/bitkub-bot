# ---------------------------------------------------------------------
# ไฟล์นี้เก็บเฉพาะ "ความลับ" (credentials/secrets) เท่านั้น
# ค่ากลยุทธ์/ความเสี่ยง/dip-buy ทั้งหมดถูกย้ายไปเป็นค่าคงที่ใน config.py แล้ว
# (ไม่ต้องพึ่ง Railway Variables อีกต่อไป ยกเว้นรายการด้านล่างนี้)
# ---------------------------------------------------------------------

# Bitkub API credentials (จำเป็น - ต้องใส่จริงเพื่อเทรด LIVE)
BITKUB_API_KEY=your_api_key_here
BITKUB_API_SECRET=your_api_secret_here

# Telegram notifications (ถ้าไม่ใช้ ปล่อยว่างไว้ได้ ระบบจะปิดการแจ้งเตือนอัตโนมัติ)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI confirmation (ถ้าไม่ใช้ ปล่อยว่างไว้ได้ บอทจะ fallback ไปใช้ technical analysis ล้วน)
GEMINI_ENABLED=False
GEMINI_API_KEYS=
